NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://scem_dev:replace-with-local-password@localhost:5432/scem_placement
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-characters
AI_SERVICE_URL=http://localhost:8000
IMPORT_PREVIEW_MINUTES=30

# Mailtrap Email Sandbox SMTP settings for local password-recovery testing.
# Copy these values from Email Testing > Sandboxes > your sandbox > Integration > SMTP.
# These sandbox credentials capture test messages; they are not production-delivery credentials.
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM=
FRONTEND_URL=http://localhost:5173

# Optional, isolated PostgreSQL database for integration tests and SQL practicals.
# The database name must include "test". Never point this at development or production data.
TEST_DATABASE_URL=

# Optional: db:seed creates these development accounts only when both values are set.
DEV_OFFICER_EMAIL=
DEV_OFFICER_PASSWORD=
DEV_RECRUITER_EMAIL=
DEV_RECRUITER_PASSWORD=
